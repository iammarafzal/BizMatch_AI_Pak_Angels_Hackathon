# Database Connection String
# Use SQLite locally or PostgreSQL on Render (e.g. postgresql://user:password@host/dbname)
DATABASE_URL="sqlite:///./bizmatch.db"

# Dual-Key Failover Google Gemini API Keys
GEMINI_API_KEY_1=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# JWT Authentication & Authorization
SECRET_KEY=super_secret_bizmatch_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (comma-separated or JSON list for Vercel deployment)
CORS_ORIGINS="http://localhost:3000,https://bizmatch-ai.vercel.app"

# Application Port (Render automatically injects $PORT)
PORT=8000
